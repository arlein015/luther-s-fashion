    "description": "Décris ici la matière, la coupe et les tailles disponibles."
  }
]
/* ============================================================
   products.js – charge les produits depuis Google Sheets
   (ou depuis products.json si le tableau n'est pas disponible)
   ============================================================ */

const PRODUCTS_SOURCE = {
  sheetCsvUrl: "https://docs.google.com/spreadsheets/d/1iyXPqTEU2OdXihbdwkmhIwZyiAo4vEqfxSy48Sx39To/edit?usp=sharing"
};

(function () {
  function norm(s) {
    return String(s || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();
  }

  function parseCSV(text) {
    const rows = [];
    let row = [], field = "", inQ = false;
    text = String(text).replace(/^\uFEFF/, "");
    for (let i = 0; i < text.length; i++) {
      const c = text[i];
      if (inQ) {
        if (c === '"') {
          if (text[i + 1] === '"') { field += '"'; i++; } else { inQ = false; }
        } else { field += c; }
      } else if (c === '"') {
        inQ = true;
      } else if (c === ",") {
        row.push(field); field = "";
      } else if (c === "\n" || c === "\r") {
        if (c === "\r" && text[i + 1] === "\n") i++;
        row.push(field); field = "";
        rows.push(row); row = [];
      } else {
        field += c;
      }
    }
    if (field !== "" || row.length) { row.push(field); rows.push(row); }
    return rows.filter(function (r) { return r.some(function (x) { return x.trim() !== ""; }); });
  }

  const ALIASES = {
    id: "id",
    nom: "title", titre: "title", title: "title", produit: "title",
    prix: "price", price: "price",
    categorie: "category", category: "category",
    photo: "image", image: "image",
    photos: "images", images: "images",
    description: "description",
    lien: "link", link: "link",
    visible: "visible", actif: "visible"
  };

  function slug(s) {
    return norm(s).replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
  }

  function parsePrice(raw) {
    let s = String(raw || "").replace(/[^\d.,]/g, "");
    if (!s) return undefined;
    if (/,\d{1,2}$/.test(s)) s = s.replace(/\./g, "").replace(",", ".");
    else if (/^\d{1,3}(\.\d{3})+$/.test(s)) s = s.replace(/\./g, "");
    else s = s.replace(/,/g, "");
    const n = parseFloat(s);
    return isNaN(n) ? undefined : n;
  }

  function fixImage(v) {
    v = String(v || "").trim();
    if (!v) return "";
    if (/^(https?:)?\/\//i.test(v) || v.indexOf("/") !== -1) return v;
    return "images/" + v;
  }

  function rowsToProducts(rows) {
    if (rows.length < 2) return [];
    const keys = rows[0].map(function (h) { return ALIASES[norm(h)] || null; });
    const list = [];
    const used = {};

    for (let r = 1; r < rows.length; r++) {
      const p = {};
      keys.forEach(function (k, i) {
        if (k) p[k] = (rows[r][i] || "").trim();
      });
      if (!p.title) continue;
      if (p.visible && /^(non|no|0|false|faux|masque|cache)$/.test(norm(p.visible))) continue;

      let id = slug(p.id || p.title) || "produit-" + r;
      if (used[id]) { used[id]++; id = id + "-" + used[id]; } else { used[id] = 1; }

      const images = p.images
        ? p.images.split(/[|\n]/).map(fixImage).filter(Boolean)
        : [];
      const image = fixImage(p.image) || images[0] || "";

      const out = { id: id, title: p.title, image: image };
      const price = parsePrice(p.price);
      if (price !== undefined) out.price = price;
      if (p.category) out.category = p.category;
      if (p.description) out.description = p.description;
      if (p.link) out.link = p.link;
      if (images.length > 1) out.images = images;
      list.push(out);
    }
    return list;
  }

  function fromJson() {
    return fetch("products.json", { cache: "no-cache" }).then(function (r) {
      if (!r.ok) throw new Error("HTTP " + r.status);
      return r.json();
    });
  }

  window.fetchProducts = function () {
    const url = PRODUCTS_SOURCE.sheetCsvUrl;
    if (!url || url.indexOf("COLLE") === 0) return fromJson();
    return fetch(url, { cache: "no-cache" })
      .then(function (r) {
        if (!r.ok) throw new Error("HTTP " + r.status);
        return r.text();
      })
      .then(function (text) {
        const list = rowsToProducts(parseCSV(text));
        if (!list.length) throw new Error("Tableau vide");
        return list;
      })
      .catch(function () { return fromJson(); });
  };
})();
